generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // oder dein bevorzugter Datenbankanbieter
}

enum Role {
  USER
  ADMIN
  MODERATOR
  INSTRUCTOR
}

enum SpaceVisibility {
  PUBLIC
  PRIVATE
}

enum SpaceMissionContributionKind {
  INSIGHT
  BUILD_ON
}

enum RewardEventType {
  COURSE_COMPLETED
}

enum RewardChangeType {
  AWARDED
  REVOKED
  REINSTATED
}

enum RewardChangeReason {
  QUIZ_REVISED
  APPROVAL_WITHDRAWN
  LEARNING_CHANGED
  ACCOUNT_INELIGIBLE
  COURSE_REMOVED
}

enum Theme {
  LIGHT
  DARK
}

enum AttendeeStatus {
  REGISTERED
  CONFIRMED
  CANCELLED
  ATTENDED
}

enum NotificationType {
  SYSTEM
  MENTION
  COMMENT
  LIKE
  FOLLOW
  EVENT
  COURSE
  CHAT_MESSAGE
  CHANNEL_CREATED
  CHANNEL_DELETED
}

enum ContentType {
  TEXT
  VIDEO
  AUDIO
  H5P
  ASSIGNMENT
}

enum AssignmentGradeAction {
  GRADED
  WITHDRAWN
}

enum PublicationSource {
  AUTHOR
  RESTORE
}

enum ResourceType {
  ARTICLE
  VIDEO
  EBOOK
  PODCAST
  COURSE
}

model Endorsement {
  id          String   @id @default(cuid())
  endorser    User     @relation("EndorsementsGiven", fields: [endorserId], references: [id])
  endorserId  String
  endorsed    User     @relation("EndorsementsReceived", fields: [endorsedId], references: [id])
  endorsedId  String
  createdAt   DateTime @default(now())

  @@unique([endorserId, endorsedId])
}

model User {
  id                 String          @id @default(cuid())
  name               String?
  email              String          @unique
  emailVerified      DateTime?
  password           String?
  image              String?         
  coverImage         String?         
  bio                String?
  title              String?         
  contact            String?         
  endorsements       Int             @default(0)
  role               Role            @default(USER)
  isTestAccount      Boolean         @default(false)
  verificationToken  String?
  resetPasswordToken String?
  lastLogin          DateTime?
  socialLinks        Json? 
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  
  accounts           Account[]
  sessions           Session[]
  posts              Post[]
  comments           Comment[]
  spaceMemberships   SpaceMember[]
  spaceDiscussions   SpaceDiscussion[]
  spaceReplies       SpaceReply[]
  createdSpaceMissions SpaceMission[]
  spacePolls SpacePoll[]
  spacePollVotes SpacePollVote[]
  spacePollVoteRequests SpacePollVoteRequest[]
  spaceMissionParticipations SpaceMissionParticipation[]
  spaceMissionContributions SpaceMissionContribution[]
  likePosts          LikePost[]
  likeComments       LikeComment[]
  likeProjects       LikeProject[]
  projectComments    ProjectComment[]
  courses            Course[]
  eventAttendees     EventAttendee[]
  eventWaitlist      EventWaitlist[]
  chatMessages       ChatMessage[]
  chatReadCursors    ChatReadCursor[]
  notifications      Notification[]
  badges             UserBadge[]
  skills             UserSkill[]
  followers          Follow[]        @relation("Following")
  following          Follow[]        @relation("Follower")
  userSettings       UserSettings?
  enrollments        Enrollment[]
  chatMemberships    ChatMember[]
  articles           Article[]
  projects           Project[]
  resources          Resource[]      @relation("UserResources")
  endorsementsGiven   Endorsement[] @relation("EndorsementsGiven")
  endorsementsReceived Endorsement[] @relation("EndorsementsReceived")
  skillEndorsementsGiven SkillEndorsement[]
  h5pContents        H5PContent[]
  certificates       Certificate[]
  contentProgress    CourseContentProgress[]
  quizAttempts       QuizAttempt[]
  practiceObjectives PracticeObjective[]
  practiceItems      PracticeItem[]
  practiceLearnerSettings PracticeLearnerSetting[]
  assignmentSubmissions AssignmentSubmission[]
  rewardLedger       RewardLedger[]
  completionRecords  CourseCompletionRecord[]
  questionBankItems  QuestionBankItem[]
  learningGoal       LearningGoal?
  learningPathways   LearningPathwayParticipation[]
  solutionDecisions  AcceptedSolutionChange[] @relation("SolutionActor")
  courseQuestions    CourseQuestion[] @relation("CourseQuestionAuthor")
  courseAnswers      CourseAnswer[] @relation("CourseAnswerAuthor")
}

model UserSettings {
  id                   String  @id @default(cuid())
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId               String  @unique
  emailNotifications   Boolean @default(true)
  pushNotifications    Boolean @default(true)
  publicRankingOptIn    Boolean @default(false)
  twoFactorAuthEnabled Boolean @default(false)
  theme                Theme   @default(LIGHT)
  language             String  @default("en")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Post {
  id        String     @id @default(cuid())
  title     String
  content   String
  published Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String

  comments  Comment[]
  likePosts LikePost[]
  tags      Tag[]      @relation("PostTags")
  acceptedSolution AcceptedSolution?
  solutionChanges AcceptedSolutionChange[]

  @@index([createdAt, id])
  @@index([published, createdAt, id])
  @@index([authorId, createdAt, id])
}

model Comment {
  id           String        @id @default(cuid())
  content      String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  post         Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId       String

  author       User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId     String

  likeComments LikeComment[]
  acceptedSolutions AcceptedSolution[]
  solutionSelections AcceptedSolutionChange[] @relation("SelectedSolution")
  previousSolutions AcceptedSolutionChange[] @relation("PreviousSolution")

  @@unique([postId, id])
  @@index([postId, createdAt, id])
  @@index([authorId, postId])
}

// Space discussions are deliberately separate from the public Post/Comment
// models. Private space content cannot enter legacy feed, search or profiles.
model Space {
  id          String          @id @default(cuid())
  name        String
  description String          @db.Text
  visibility  SpaceVisibility
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  members     SpaceMember[]
  discussions SpaceDiscussion[]
  missions    SpaceMission[]
  polls       SpacePoll[]
}

// Voluntary Space decisions. API projections expose totals and the caller's
// choice only; small groups can still infer choices from changing totals.
model SpacePoll {
  id            String @id @default(cuid())
  spaceId       String
  space         Space @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  creatorId     String?
  creator       User? @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  requestId     String
  payloadDigest String
  question      String
  createdAt     DateTime @default(now())
  closedAt      DateTime?
  hiddenAt      DateTime?
  moderationRevision Int @default(0)
  options       SpacePollOption[]
  votes         SpacePollVote[]
  requests      SpacePollVoteRequest[]

  @@unique([spaceId, requestId])
  @@index([spaceId, createdAt, id])
  @@index([creatorId, createdAt])
}

model SpacePollOption {
  id       String @id @default(cuid())
  pollId   String
  poll     SpacePoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  position Int
  label    String
  votes    SpacePollVote[]

  @@unique([pollId, id])
  @@unique([pollId, position])
}

// Composite option FK makes cross-poll votes impossible in both providers.
model SpacePollVote {
  pollId   String
  userId   String
  optionId String
  revision Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  poll     SpacePoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option   SpacePollOption @relation(fields: [pollId, optionId], references: [pollId, id], onDelete: Cascade)
  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([pollId, userId])
  @@index([pollId, optionId])
  @@index([userId])
}

// Bounded durable receipts make replay a no-op even after later choice changes.
model SpacePollVoteRequest {
  pollId        String
  userId        String
  requestId     String
  payloadDigest String
  createdAt     DateTime @default(now())
  poll          SpacePoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([pollId, userId, requestId])
  @@index([userId, createdAt])
}

// Private-Space cooperative activity. This is not course or mastery evidence.
// The one-open-mission partial unique index lives in both provider migrations.
model SpaceMission {
  id            String @id @default(cuid())
  spaceId       String
  space         Space @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  creatorId     String?
  creator       User? @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  requestId     String
  payloadDigest String
  title         String
  prompt        String @db.Text
  createdAt     DateTime @default(now())
  closedAt      DateTime?
  // Optional immutable soft-week metadata; existing missions remain self-paced.
  weekStartsOn  String?
  weekTimezone  String?
  weekStartsAt  DateTime?
  weekEndsAt    DateTime?
  participations SpaceMissionParticipation[]
  contributions SpaceMissionContribution[]

  @@index([spaceId, createdAt, id])
  @@unique([spaceId, requestId])
}

// A new explicit self-join advances the epoch; old posts can never be revived
// by a later join. Membership revocation opts out in the same transaction.
model SpaceMissionParticipation {
  missionId  String
  userId     String
  epoch      Int
  joinedAt   DateTime @default(now())
  optedOutAt DateTime?
  mission    SpaceMission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([missionId, userId])
  @@index([userId, optedOutAt])
  @@index([missionId, optedOutAt])
}

// Named, voluntary teach-back activity, separate from all learning evidence.
// Epoch is immutable historical consent, intentionally not a relation to the
// mutable participation epoch. The composite target FK enforces mission scope.
model SpaceMissionContribution {
  id                   String @id @default(cuid())
  missionId            String
  mission              SpaceMission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  authorId             String
  author               User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  epoch                Int
  kind                 SpaceMissionContributionKind
  content              String @db.Text
  targetContributionId String?
  target               SpaceMissionContribution? @relation("MissionBuildOn", fields: [missionId, targetContributionId], references: [missionId, id], onDelete: Cascade)
  buildOns             SpaceMissionContribution[] @relation("MissionBuildOn")
  requestId            String
  payloadDigest        String
  createdAt            DateTime @default(now())
  hiddenAt             DateTime?
  withdrawnAt          DateTime?

  @@unique([missionId, id])
  @@unique([missionId, authorId, requestId])
  @@index([missionId, createdAt, id])
  @@index([missionId, authorId, epoch, kind])
  @@index([authorId])
}

model SpaceMember {
  spaceId  String
  userId   String
  joinedAt DateTime @default(now())
  space    Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([spaceId, userId])
  @@index([userId, spaceId])
}

model SpaceDiscussion {
  id        String       @id @default(cuid())
  spaceId   String
  space     Space        @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  authorId  String
  author    User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  requestId String
  payloadDigest String
  title     String
  content   String       @db.Text
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  hiddenAt  DateTime?
  replies   SpaceReply[]

  @@index([spaceId, createdAt, id])
  @@index([authorId])
  @@unique([spaceId, authorId, requestId])
}

model SpaceReply {
  id           String          @id @default(cuid())
  discussionId String
  discussion   SpaceDiscussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  authorId     String
  author       User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  requestId    String
  payloadDigest String
  content      String          @db.Text
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  hiddenAt     DateTime?

  @@index([discussionId, createdAt, id])
  @@index([authorId])
  @@unique([discussionId, authorId, requestId])
}

// A single live author-selected reply; deletion removes the current signal.
model AcceptedSolution {
  postId    String @id
  commentId String @unique
  revision  String @unique
  createdAt DateTime @default(now())
  post      Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  // The composite FK prevents a reply from another discussion being selected.
  comment   Comment @relation(fields: [postId, commentId], references: [postId, id], onDelete: Cascade)
}

// Server-created decision history, without content snapshots. Erasure removes
// identities and target references without destroying the transition history.
model AcceptedSolutionChange {
  id                String @id
  action            String
  createdAt         DateTime @default(now())
  actorId           String?
  postId            String?
  previousCommentId String?
  commentId         String?
  actor             User? @relation("SolutionActor", fields: [actorId], references: [id], onDelete: SetNull)
  post              Post? @relation(fields: [postId], references: [id], onDelete: SetNull)
  previousComment   Comment? @relation("PreviousSolution", fields: [previousCommentId], references: [id], onDelete: SetNull)
  comment           Comment? @relation("SelectedSolution", fields: [commentId], references: [id], onDelete: SetNull)

  @@index([postId, createdAt])
}

// Polymorphic IDs intentionally keep the moderation audit after a target or
// account is deleted. Route handlers validate public target visibility and
// derive reporter/reviewer IDs from the authenticated session.
model ContentReport {
  id             String    @id @default(cuid())
  reporterId     String
  targetType     String
  targetId       String
  // Server-derived, denormalized scope for privacy-filtered report queues.
  // No FK: moderation history survives deletion of the target or space.
  scopeSpaceId   String?
  reason         String
  details        String?   @db.Text
  status         String    @default("OPEN")
  createdAt      DateTime  @default(now())
  reviewedAt     DateTime?
  reviewedById   String?
  resolutionNote String?   @db.Text

  @@unique([reporterId, targetType, targetId])
  @@index([reporterId, createdAt])
  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([scopeSpaceId, status, createdAt])
}

model LikePost {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String

  @@unique([userId, postId], name: "user_post_unique")
  @@index([postId])
}

model LikeComment {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  comment   Comment   @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId String

  @@unique([userId, commentId], name: "user_comment_unique")
  @@index([commentId])
}

model Tag {
  id        String      @id @default(cuid())
  name      String      @unique
  posts     Post[]      @relation("PostTags")
  articles  Article[]   @relation("ArticleTags")
  projects  Project[]   @relation("ProjectTags")
}

model Course {
  id           String          @id @default(cuid())
  title        String
  description  String
  instructor   User            @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  instructorId String
  startDate    DateTime?
  endDate      DateTime?
  price        Float?
  currency     String?
  maxStudents  Int?
  rewardEligible Boolean @default(false)
  rewardApprovalRevision String?
  imageUrl     String?
  // Null is an unpublished course. New courses create a draft transactionally.
  activePublicationId String?
  activePublication CoursePublication? @relation("ActiveCoursePublication", fields: [activePublicationId], references: [id], onDelete: SetNull)
  publications CoursePublication[] @relation("CoursePublicationHistory")
  draft CourseDraft?
  publicationRequests PublicationRequest[]
  assets CourseAsset[]
  enrollments  Enrollment[]
  lessons      Lesson[]
  contents     CourseContent[]
  certificates Certificate[]
  contentProgress CourseContentProgress[]
  quizAttempts QuizAttempt[]
  assignmentSubmissions AssignmentSubmission[]
  practiceDraft CoursePracticeDraft?
  practiceSnapshots PracticeSnapshot[]
  practicePublicationRequests PracticePublicationRequest[]
  practiceLearnerSettings PracticeLearnerSetting[]
  questions    CourseQuestion[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([activePublicationId])
}

model Lesson {
  id            String   @id @default(cuid())
  title         String
  content       String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId      String
  orderInCourse Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CourseContent {
  id        String          @id @default(cuid())
  title     String
  type      ContentType?
  content   String
  order     Int
  course    Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId  String
  parent    CourseContent?  @relation("ParentChild", fields: [parentId], references: [id])
  parentId  String?
  children  CourseContent[] @relation("ParentChild")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  archivedAt DateTime?
  progress  CourseContentProgress[]

  @@index([courseId, archivedAt])
}

// Course discussion is private to current participants. It must never be
// projected into the public Post/Comment feed, search, profile or rewards.
model CourseQuestion {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("CourseQuestionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  requestId String
  title     String
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  hiddenAt  DateTime?
  solutionRevision String?
  answers   CourseAnswer[]
  solution  CourseQuestionSolution?

  @@unique([courseId, authorId, requestId])
  @@index([courseId, createdAt, id])
}

model CourseAnswer {
  id         String   @id @default(cuid())
  questionId String
  question   CourseQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation("CourseAnswerAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  requestId  String
  body       String   @db.Text
  createdAt  DateTime @default(now())
  hiddenAt   DateTime?
  selectedIn CourseQuestionSolution? @relation("SelectedCourseAnswer")

  @@unique([questionId, id])
  @@unique([questionId, authorId, requestId])
  @@index([questionId, createdAt, id])
}

// The composite FK guarantees a selected answer belongs to this question.
model CourseQuestionSolution {
  questionId String @id
  question   CourseQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerId   String @unique
  answer     CourseAnswer @relation("SelectedCourseAnswer", fields: [questionId, answerId], references: [questionId, id], onDelete: Cascade)
  revision   String @unique
  createdAt  DateTime @default(now())

  @@unique([questionId, answerId])
}

// Private author-owned questions. Editing advances the pointer; existing
// revisions and copied quiz questions remain unchanged.
model QuestionBankItem {
  id String @id @default(cuid())
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  latestRevision Int @default(1)
  revisions QuestionBankRevision[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, updatedAt])
}

model QuestionBankRevision {
  itemId String
  item QuestionBankItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  revision Int
  questionJson String @db.Text
  createdAt DateTime @default(now())

  @@id([itemId, revision])
}

// Only the explicit publish transaction may project this saved payload into
// Course/CourseContent. The payload is bounded and validated by authoring code.
model CourseDraft {
  courseId String @id
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  revision Int @default(0)
  basePublicationId String?
  basePublication CoursePublication? @relation("DraftBasePublication", fields: [basePublicationId], references: [id], onDelete: SetNull)
  payload String @db.Text
  digest String
  lastEditorId String?
  updatedAt DateTime @updatedAt
}

// Immutable, author-only snapshots.
model CoursePublication {
  id String @id @default(cuid())
  courseId String
  course Course @relation("CoursePublicationHistory", fields: [courseId], references: [id], onDelete: Cascade)
  sequence Int
  source PublicationSource
  payload String @db.Text
  digest String
  contentCount Int
  previousPublicationId String?
  previousPublication CoursePublication? @relation("PreviousCoursePublication", fields: [previousPublicationId], references: [id], onDelete: SetNull)
  laterPublications CoursePublication[] @relation("PreviousCoursePublication")
  actorId String?
  recordedAt DateTime @default(now())
  activeFor Course[] @relation("ActiveCoursePublication")
  draftsBasedOn CourseDraft[] @relation("DraftBasePublication")
  requests PublicationRequest[] @relation("RequestPublication")
  quizAttempts QuizAttempt[] @relation("AttemptPublication")
  certificates Certificate[] @relation("CertificatePublication")
  assignmentSubmissions AssignmentSubmission[] @relation("AssignmentPublication")
  practiceSnapshots PracticeSnapshot[]

  @@unique([courseId, sequence])
  @@unique([id, courseId])
  @@index([courseId, recordedAt])
}

// The receipt is written even when publishing an unchanged saved payload.
model PublicationRequest {
  courseId String
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  requestId String
  actorId String
  requestDigest String
  publicationId String
  publication CoursePublication @relation("RequestPublication", fields: [publicationId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([courseId, requestId])
  @@index([publicationId])
}

// Formative practice is separate from credential quizzes and never contributes
// to QuizAttempt, CourseContentProgress, rewards or certificates.
model PracticeObjective {
  id String @id @default(cuid())
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title String
  description String @default("") @db.Text
  revision Int @default(1)
  items PracticeItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, updatedAt])
  @@unique([id, ownerId])
}

model PracticeItem {
  id String @id @default(cuid())
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  objectiveId String
  objective PracticeObjective @relation(fields: [objectiveId, ownerId], references: [id, ownerId], onDelete: Cascade)
  latestRevision Int @default(1)
  revisions PracticeItemRevision[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, updatedAt])
  @@index([objectiveId])
}

model PracticeItemRevision {
  itemId String
  item PracticeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  revision Int
  payload String @db.Text
  createdAt DateTime @default(now())

  @@id([itemId, revision])
}

// Explicit pinned item revisions. Editing this draft does not expose anything
// to learners until an instructor/admin publishes against the active course ID.
model CoursePracticeDraft {
  courseId String @id
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  revision Int @default(0)
  payload String @db.Text
  digest String
  lastEditorId String?
  updatedAt DateTime @updatedAt
}

// Immutable copied item/answer snapshot, bound to exactly one credential-course
// publication. A later course publication does not inherit this snapshot.
model PracticeSnapshot {
  id String @id @default(cuid())
  courseId String
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  coursePublicationId String
  coursePublication CoursePublication @relation(fields: [coursePublicationId, courseId], references: [id, courseId], onDelete: Cascade)
  sequence Int
  draftRevision Int
  payload String @db.Text
  digest String
  itemCount Int
  actorId String
  recordedAt DateTime @default(now())
  requests PracticePublicationRequest[]
  learnerSessions PracticeLearnerSession[]
  learnerSchedules PracticeLearnerSchedule[]

  @@unique([courseId, sequence])
  @@unique([id, courseId])
  @@index([courseId, coursePublicationId, sequence])
}

model PracticePublicationRequest {
  courseId String
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  requestId String
  actorId String
  requestDigest String
  snapshotId String
  snapshot PracticeSnapshot @relation(fields: [snapshotId, courseId], references: [id, courseId], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([courseId, requestId])
  @@index([snapshotId])
}

// Private, opt-in learner evidence. A published practice snapshot is the only
// course-level availability switch; no credential quiz state is referenced.
model PracticeLearnerSetting {
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  optedIn Boolean @default(false)
  paused Boolean @default(false)
  lastActivityAt DateTime @default(now())
  resetTokenHash String?
  resetTokenExpiresAt DateTime?
  sessions PracticeLearnerSession[]
  schedules PracticeLearnerSchedule[]

  @@id([userId, courseId])
  @@index([lastActivityAt])
}

model PracticeLearnerSession {
  id String @id @default(cuid())
  userId String
  courseId String
  setting PracticeLearnerSetting @relation(fields: [userId, courseId], references: [userId, courseId], onDelete: Cascade)
  snapshotId String
  snapshot PracticeSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  status String @default("ACTIVE")
  answeredCount Int @default(0)
  pendingReservationId String?
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reservations PracticeLearnerReservation[]

  @@index([userId, courseId, status])
  @@index([snapshotId])
}

model PracticeLearnerReservation {
  id String @id @default(cuid())
  sessionId String
  session PracticeLearnerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  ordinal Int
  itemId String
  itemRevision Int
  shownAt DateTime @default(now())
  answer PracticeLearnerAnswer?

  @@unique([sessionId, ordinal])
  @@unique([sessionId, itemId])
  @@index([itemId, itemRevision])
}

model PracticeLearnerAnswer {
  id String @id @default(cuid())
  reservationId String @unique
  reservation PracticeLearnerReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  optionIndex Int
  correct Boolean
  canContinue Boolean @default(true)
  confidence QuizConfidence?
  nextDueAt DateTime
  answeredAt DateTime @default(now())
  receipts PracticeLearnerSubmissionReceipt[]

  @@index([answeredAt])
}

model PracticeLearnerSubmissionReceipt {
  sessionId String
  submissionId String
  answerId String
  answer PracticeLearnerAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  requestDigest String
  createdAt DateTime @default(now())

  @@id([sessionId, submissionId])
  @@index([createdAt])
}

model PracticeLearnerSchedule {
  userId String
  courseId String
  setting PracticeLearnerSetting @relation(fields: [userId, courseId], references: [userId, courseId], onDelete: Cascade)
  snapshotId String
  snapshot PracticeSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  itemId String
  itemRevision Int
  dueAt DateTime
  intervalDays Int @default(0)
  streak Int @default(0)
  lastAnsweredAt DateTime

  @@id([userId, courseId, snapshotId, itemId])
  @@index([userId, courseId, snapshotId, dueAt])
}

// Written only after a successful trusted retention sweep. Learner practice
// persistence fails closed if this heartbeat is missing or stale.
model PracticeRetentionHealth {
  id String @id
  lastSuccessAt DateTime?
  updatedAt DateTime @updatedAt
}

// Private files referenced by drafts, active content or publication history.
// The stable URL is /api/courses/:courseId/assets/:assetId.
model CourseAsset {
  id String @id @default(cuid())
  courseId String
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uploaderId String?
  storageKey String @unique
  contentType String
  byteSize Int
  createdAt DateTime @default(now())

  @@index([courseId])
}

model CourseContentProgress {
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId    String
  content     CourseContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  contentId   String
  revision    String
  completedAt DateTime      @default(now())

  @@id([userId, contentId])
  @@index([userId, courseId])
  @@index([courseId])
  @@index([contentId])
}

// Attempts retain their content ID and scored revision even if an instructor
// removes that content; only active CourseContentProgress drives eligibility.
model QuizAttempt {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId     String
  contentId    String
  submissionId String
  answerDigest String
  confidenceDigest String?
  revision     String
  score        Float
  passed       Boolean
  submittedAt  DateTime @default(now())
  publicationId String?
  publication CoursePublication? @relation("AttemptPublication", fields: [publicationId], references: [id], onDelete: SetNull)
  itemEvidence QuizAttemptItemEvidence[]

  @@unique([userId, contentId, submissionId])
  @@index([userId, contentId, revision, submittedAt])
  @@index([courseId])
  @@index([publicationId])
}

// Private, server-graded evidence for a single immutable quiz attempt. The
// parent carries the publication and scored content revision; no raw answer or
// grading key is persisted here.
model QuizAttemptItemEvidence {
  attempt QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  attemptId String
  questionId String
  correct Boolean
  confidence QuizConfidence?

  @@id([attemptId, questionId])
}

enum QuizConfidence {
  SURE
  SOMEWHAT_SURE
  UNSURE
  GUESSED
}

/** Learner text is private. A fresh submission never replaces an older answer. */
model AssignmentSubmission {
  id String @id @default(cuid())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String
  contentId String
  publication CoursePublication @relation("AssignmentPublication", fields: [publicationId], references: [id], onDelete: Cascade)
  publicationId String
  revision String
  passingScore Int
  requestId String
  response String @db.Text
  responseDigest String
  attemptNumber Int
  submittedAt DateTime @default(now())
  decisions AssignmentGradeDecision[]

  @@unique([userId, contentId, requestId])
  @@unique([userId, contentId, attemptNumber])
  @@index([courseId, contentId, revision, userId, attemptNumber])
  @@index([courseId, contentId])
  @@index([publicationId])
}

/** Every correction and withdrawal is an append-only staff decision. */
model AssignmentGradeDecision {
  id String @id @default(cuid())
  submission AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId String
  requestId String
  graderId String
  action AssignmentGradeAction
  score Int?
  feedback String? @db.Text
  sequence Int
  createdAt DateTime @default(now())

  @@unique([submissionId, requestId])
  @@unique([submissionId, sequence])
  @@index([createdAt])
}

model Enrollment {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId    String
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?
  
  @@unique([userId, courseId])
}

model RewardLedger {
  id        String          @id @default(cuid())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  eventType RewardEventType
  sourceId  String
  courseTitle String
  points    Int
  stateVersion Int     @default(1)
  awardedAt DateTime        @default(now())
  revokedAt DateTime?
  changes   RewardLedgerChange[]

  @@unique([userId, eventType, sourceId])
  @@index([userId, revokedAt])
  @@index([eventType, sourceId])
}

model RewardLedgerChange {
  id          String             @id @default(cuid())
  ledger      RewardLedger       @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  ledgerId    String
  version     Int
  type        RewardChangeType
  reason      RewardChangeReason?
  pointsDelta Int
  createdAt   DateTime           @default(now())

  @@unique([ledgerId, version])
  @@index([createdAt])
}

/** Private first-completion evidence survives a course's later deletion. */
model CourseCompletionRecord {
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  courseId    String
  courseTitle String
  completedAt DateTime

  @@id([userId, courseId])
  @@index([userId, completedAt])
}

/** A private, opt-in calendar-day challenge; progress is always derived from current verified course records. */
model LearningGoal {
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String    @id
  targetLeaves Int
  durationDays Int
  timezone    String
  startedAt   DateTime
  endsAt      DateTime
  pausedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/** Immutable, private opt-in course sequence; source IDs survive course deletion. */
model LearningPathway {
  id          String @id @default(cuid())
  title       String
  description String
  badgeLabel  String
  createdById String
  createdAt   DateTime @default(now())
  sealedAt    DateTime?
  courses     LearningPathwayCourse[]
  participants LearningPathwayParticipation[]
}

model LearningPathwayCourse {
  pathway   LearningPathway @relation(fields: [pathwayId], references: [id], onDelete: Restrict)
  pathwayId String
  position  Int
  courseId  String
  title     String

  @@id([pathwayId, position])
  @@unique([pathwayId, courseId])
  @@index([courseId])
}

/** Unique private badge state; never projected into public UserBadge surfaces. */
model LearningPathwayParticipation {
  user               User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String
  pathway            LearningPathway @relation(fields: [pathwayId], references: [id], onDelete: Restrict)
  pathwayId          String
  joinedAt           DateTime @default(now())
  optedOutAt         DateTime?
  badgeActive        Boolean @default(false)
  badgeFirstAwardedAt DateTime?
  stateVersion       Int @default(0)
  changes            LearningPathwayChange[]

  @@id([userId, pathwayId])
  @@index([pathwayId])
}

model LearningPathwayChange {
  id            String @id @default(cuid())
  participation LearningPathwayParticipation @relation(fields: [userId, pathwayId], references: [userId, pathwayId], onDelete: Cascade)
  userId        String
  pathwayId     String
  version       Int
  type          String
  reason        String?
  createdAt     DateTime @default(now())

  @@unique([userId, pathwayId, version])
  @@index([createdAt])
}

model Event {
  id           String          @id @default(cuid())
  title        String
  description  String
  date         DateTime
  location     String
  maxAttendees Int?
  attendees    EventAttendee[]
  waitlist     EventWaitlist[]
  category     String
  timezone     String          @default("Europe/Berlin")
  startTime    String
  endTime      String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model EventAttendee {
  id      String         @id @default(cuid())
  event   Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String
  status  AttendeeStatus @default(REGISTERED)

  @@unique([eventId, userId])
}

// Increasing, non-reused IDs define FIFO order; leaving and rejoining creates
// a fresh queue entry and promotion-notification identity.
model EventWaitlist {
  id        Int      @id @default(autoincrement())
  eventId   String
  userId    String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, id])
  @@index([userId])
}

model ChatChannel {
  id        String        @id @default(cuid())
  name      String
  isPrivate Boolean       @default(false)
  messages  ChatMessage[]
  readCursors ChatReadCursor[]
  members   ChatMember[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

// A row records that this account has visibly opened a readable channel.
// Null position means it was empty when opened; absence means unvisited.
model ChatReadCursor {
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId         String
  channel           ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  lastReadCreatedAt DateTime?
  lastReadId        String?

  @@id([userId, channelId])
}

model ChatMember {
  id        String      @id @default(cuid())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId String
  joinedAt  DateTime    @default(now())

  @@unique([userId, channelId])
}

model ChatMessage {
  id          String      @id @default(cuid())
  content     String
  channelId   String
  channel     ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId    String
  author      User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  imageUrl    String?     
  messageType String      @default("text") 

  @@index([channelId, createdAt, id])
}

model Notification {
  id        String           @id @default(cuid())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      NotificationType
  content   String
  // Only server-side domain events set these. Never persist a client URL.
  targetType String?
  targetId   String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, targetType, targetId])
}

model Badge {
  id          String      @id @default(cuid())
  name        String      @unique
  description String
  image       String
  users       UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  badgeId   String
  awardedAt DateTime @default(now())

  @@unique([userId, badgeId])
}

model Skill {
  id        String      @id @default(cuid())
  name      String      @unique
  category  String
  users     UserSkill[]
}

model UserSkill {
  id           String @id @default(cuid())
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  skill        Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId      String
  level        Int
  endorsements Int    @default(0)
  endorsementRecords SkillEndorsement[]

  @@unique([userId, skillId])
}

model SkillEndorsement {
  id          String    @id @default(cuid())
  endorser    User      @relation(fields: [endorserId], references: [id], onDelete: Cascade)
  endorserId  String
  userSkill   UserSkill @relation(fields: [userSkillId], references: [id], onDelete: Cascade)
  userSkillId String
  createdAt   DateTime  @default(now())

  @@unique([endorserId, userSkillId])
}

model Follow {
  id          String   @id @default(cuid())
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followerId  String
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  followingId String
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

model Article {
  id            String   @id @default(cuid())
  title         String
  content       String
  category      String
  featuredImage String?  // Optionales Feld für das Beitragsbild
  isPublished   Boolean  @default(false) // Neues Feld
  author        User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tags          Tag[]    @relation("ArticleTags")
}

model Project {
  id           String          @id @default(cuid())
  title        String
  description  String
  category     String?
  link         String
  imageUrl     String?
  gradientFrom String
  gradientTo   String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  author       User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId     String
  tags         Tag[]           @relation("ProjectTags")
  likes        LikeProject[]
  comments     ProjectComment[]
}

model LikeProject {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  @@unique([userId, projectId], name: "user_project_unique")
}

model ProjectComment {
  id        String    @id @default(cuid())
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
}

model Resource {
  id         String        @id @default(cuid())
  title      String
  type       ResourceType
  category   String
  author     User          @relation("UserResources", fields: [authorId], references: [id], onDelete: Cascade)
  authorId   String
  url        String
  color      String
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model H5PContent {
  id          String    @id @default(cuid())
  title       String
  contentType String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      String
  user        User      @relation(fields: [userId], references: [id])
}

model Certificate {
  id          String    @id
  user        User      @relation(fields: [userId], references: [id])
  userId      String
  course      Course    @relation(fields: [courseId], references: [id])
  courseId    String
  issuedAt    DateTime  @default(now())
  courseName  String
  userName    String
  publicationId String?
  publication CoursePublication? @relation("CertificatePublication", fields: [publicationId], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([courseId])
  @@index([publicationId])
}
