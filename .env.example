# Generate an independent secret: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3013"
NEXT_PUBLIC_APP_URL="http://localhost:3013"

# SQLite is the default Docker provider. The default Compose file overrides
# DATABASE_PROVIDER and DATABASE_URL with sqlite and file:/app/data/forge.db.
DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:/absolute/path/to/forge.db"

# PostgreSQL is available through docker-compose.postgresql.yml. Set these
# values when using that explicit stack; DATABASE_URL must point to service db.
# DATABASE_PROVIDER="postgresql"
# POSTGRES_USER="forge"
# POSTGRES_PASSWORD=""
# POSTGRES_DB="forge"
# DATABASE_URL="postgresql://forge:CHANGE_ME@db:5432/forge?schema=public"

# Optional Google login. Leave both blank to disable. See docs/OAUTH_LOGIN.md.
# Requires NEXTAUTH_SECRET >= 32 characters and HTTPS NEXTAUTH_URL in production.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional generic OpenID Connect login (authorization code + PKCE + nonce).
# Leave the three required values blank to disable. Issuer must match exactly.
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_NAME="OpenID Connect"
# Private operator allowlist for extra HTTPS endpoint origins, comma-separated.
# Issuer origin is allowed implicitly. Public DNS names only; no IP literals.
OIDC_ALLOWED_ENDPOINT_ORIGINS=""
# Supported: client_secret_basic (default) or client_secret_post; RS256 ID tokens.
OIDC_TOKEN_AUTH_METHOD="client_secret_basic"

# Demo seed is opt-in and forbidden when NODE_ENV=production.
ALLOW_DEMO_SEED="false"

# Enable only behind a trusted proxy that overwrites forwarded client headers.
TRUST_PROXY="false"

# Optional: persistent private H5P package directory (default: data/h5p).
# H5P_STORAGE_PATH=/absolute/path/to/h5p
