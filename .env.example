# Generate an independent secret: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3013"
NEXT_PUBLIC_APP_URL="http://localhost:3013"

# PostgreSQL is the default provider. In the default Docker Compose stack,
# DATABASE_URL must point to the service named db (not localhost).
DATABASE_PROVIDER="postgresql"
# Set a strong password in both POSTGRES_PASSWORD and DATABASE_URL.
POSTGRES_USER="forge"
POSTGRES_PASSWORD=""
POSTGRES_DB="forge"
DATABASE_URL="postgresql://forge:CHANGE_ME@localhost:5432/forge?schema=public"

# Optional SQLite with docker-compose.sqlite.yml: the Compose file overrides
# DATABASE_PROVIDER and DATABASE_URL with sqlite and file:/app/data/forge.db.
# Its named volume persists the DB across container replacement.

# Optional Google OAuth. Leave both blank to disable Google login.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Demo seed is opt-in and forbidden when NODE_ENV=production.
ALLOW_DEMO_SEED="false"

# Enable only behind a trusted proxy that overwrites forwarded client headers.
TRUST_PROXY="false"
